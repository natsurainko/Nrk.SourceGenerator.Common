<Project>
  <!-- Compile helpers into the analyzer: Roslyn does not probe arbitrary analyzer dependencies. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**/*.cs"
             Exclude="$(MSBuildThisFileDirectory)obj/**/*.cs;$(MSBuildThisFileDirectory)bin/**/*.cs"
             Link="SourceGeneration/%(RecursiveDir)%(Filename)%(Extension)"
             Visible="false" />
  </ItemGroup>
</Project>
